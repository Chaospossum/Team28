{
  "name": "right-plant-right-place",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:stop && concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:stop": "sh -c 'for p in 43123 43124; do lsof -ti tcp:$p | xargs kill -9 2>/dev/null; done' || true",
    "dev:web": "vite",
    "dev:server": "node --watch-path=./server --watch server/index.js",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && VITE_BASE=/Team28/ VITE_STATIC_HOST=1 vite build && cp dist/index.html dist/404.html",
    "lint": "oxlint",
    "preview": "vite preview --port 43123 --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@turf/area": "^7.2.0",
    "@turf/centroid": "^7.2.0",
    "@turf/helpers": "^7.4.0",
    "@types/leaflet": "^1.9.22",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lz-string": "^1.5.0",
    "proj4": "^2.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "suncalc": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
